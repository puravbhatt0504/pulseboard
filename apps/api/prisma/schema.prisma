generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]
  memberships   BoardMember[]
  activities    Activity[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum Role {
  owner
  editor
  viewer
}

model Board {
  id         String        @id @default(cuid())
  title      String
  createdAt  DateTime      @default(now())
  members    BoardMember[]
  columns    Column[]
  activities Activity[]
}

model BoardMember {
  boardId String
  userId  String
  role    Role
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([boardId, userId])
  @@index([userId])
}

model Column {
  id       String @id @default(cuid())
  boardId  String
  title    String
  position String
  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards    Card[]

  @@index([boardId, position])
}

model Card {
  id          String   @id @default(cuid())
  columnId    String
  title       String
  description String   @default("")
  position    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  column      Column   @relation(fields: [columnId], references: [id], onDelete: Cascade)

  @@index([columnId, position])
}

model Activity {
  id        String   @id @default(cuid())
  boardId   String
  userId    String
  type      String
  data      Json
  createdAt DateTime @default(now())
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
