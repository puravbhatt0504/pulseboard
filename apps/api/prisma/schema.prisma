generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]
  memberships   BoardMember[]
  activities    Activity[]
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum Role {
  owner
  editor
  viewer
}

model Board {
  id         String        @id @default(cuid())
  title      String
  createdAt  DateTime      @default(now())
  members    BoardMember[]
  columns    Column[]
  activities Activity[]
  exports    Export[]
}

model BoardMember {
  boardId String
  userId  String
  role    Role
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([boardId, userId])
  @@index([userId])
}

model Column {
  id       String @id @default(cuid())
  boardId  String
  title    String
  position String
  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards    Card[]

  @@index([boardId, position])
}

model Card {
  id          String   @id @default(cuid())
  columnId    String
  title       String
  description String   @default("")
  position    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  column      Column   @relation(fields: [columnId], references: [id], onDelete: Cascade)
  doc         CardDoc?

  @@index([columnId, position])
}

// Collaborative description: full Yjs state (Y.encodeStateAsUpdate, so always compacted).
// Card.description holds its plain-text projection for search/export/board view.
model CardDoc {
  cardId    String   @id
  state     Bytes
  updatedAt DateTime @updatedAt
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String   @id @default(cuid())
  boardId   String
  userId    String
  type      String
  data      Json
  createdAt DateTime @default(now())
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// One row per RelayQ board.export job; RelayQ's signed callback fills in the download url.
model Export {
  jobId       String   @id
  boardId     String
  requestedBy String
  format      String
  status      String   @default("queued")
  url         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
}
