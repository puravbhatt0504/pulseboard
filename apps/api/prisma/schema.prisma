generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  createdAt     DateTime       @default(now())
  refreshTokens RefreshToken[]
  memberships   BoardMember[]
  activities    Activity[]
  assignedCards Card[]         @relation("CardAssignee")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum Role {
  owner
  editor
  viewer
}

model Board {
  id         String           @id @default(cuid())
  title      String
  createdAt  DateTime         @default(now())
  members    BoardMember[]
  columns    Column[]
  activities Activity[]
  exports    Export[]
  // The labels cards on this board may carry (and that AI triage may suggest).
  labels     String[]         @default(["bug", "feature", "docs", "chore"])
  feedback   TriageFeedback[]
}

model BoardMember {
  boardId String
  userId  String
  role    Role
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([boardId, userId])
  @@index([userId])
}

model Column {
  id       String @id @default(cuid())
  boardId  String
  title    String
  position String
  board    Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  cards    Card[]

  @@index([boardId, position])
}

model Card {
  id          String            @id @default(cuid())
  columnId    String
  title       String
  description String            @default("")
  position    String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  column      Column            @relation(fields: [columnId], references: [id], onDelete: Cascade)
  doc         CardDoc?
  embedding   CardEmbedding?
  labels      String[]          @default([])
  priority    String? // low | medium | high | urgent
  assigneeId  String?
  assignee    User?             @relation("CardAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  triage      TriageSuggestion?

  @@index([columnId, position])
}

// Collaborative description: full Yjs state (Y.encodeStateAsUpdate, so always compacted).
// Card.description holds its plain-text projection for search/export/board view.
model CardDoc {
  cardId    String   @id
  state     Bytes
  updatedAt DateTime @updatedAt
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

model Activity {
  id        String   @id @default(cuid())
  boardId   String
  userId    String
  type      String
  data      Json
  createdAt DateTime @default(now())
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// One row per RelayQ board.export job; RelayQ's signed callback fills in the download url.
model Export {
  jobId       String   @id
  boardId     String
  requestedBy String
  format      String
  status      String   @default("queued")
  url         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId])
}

// Semantic search (Phase 10). Written with raw SQL (Prisma can't bind vector). contentHash = sha256 of the text
// that was embedded, so an edit that doesn't change the text costs nothing. The HNSW and full-text indexes live
// only in migrations/3_card_embedding (Prisma can't express them).
model CardEmbedding {
  cardId      String                      @id
  embedding   Unsupported("vector(1024)")
  contentHash String
  model       String
  updatedAt   DateTime                    @updatedAt
  card        Card                        @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

// AI triage (Phase 12): the validated suggestion for a new card. Never applied until a member accepts a field.
model TriageSuggestion {
  cardId     String   @id
  labels     String[]
  priority   String?
  assigneeId String?
  reason     String
  model      String
  createdAt  DateTime @default(now())
  card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

// One accept/reject per card and field (labels | priority | assignee). No FK to Card: stats outlive deleted cards.
model TriageFeedback {
  id        String   @id @default(cuid())
  boardId   String
  cardId    String
  userId    String
  field     String
  accepted  Boolean
  createdAt DateTime @default(now())
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@unique([cardId, field])
  @@index([boardId])
}
